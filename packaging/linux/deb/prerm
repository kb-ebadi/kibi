#!/bin/sh
# kibi / kibi-lite .deb: before the files go. Stops the engine (containers it
# ran stop with it) and withdraws Kibi's docker CLI from PATH.
set -e
# Removing Kibi stops everything it runs: the engine (above, which stops its
# containers), and any window or kibi command still open from this package
# (`kibi share`, `kibi ui`), first asked to quit, then made to.
stop_everything() {
  for sig in TERM KILL; do
    pkill -"$sig" -f '^/usr/lib/kibi/kibi-window( |$)' 2>/dev/null || true
    pkill -"$sig" -f '^(/usr)?/bin/kibi( |$)' 2>/dev/null || true
    [ "$sig" = KILL ] || sleep 1
  done
}
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now kibi.service || true
    fi
    stop_everything
    if [ -x /usr/libexec/kibi/docker ]; then
      update-alternatives --remove docker /usr/libexec/kibi/docker || true
      for p in docker-compose docker-buildx; do
        update-alternatives --remove "$p" "/usr/libexec/kibi/cli-plugins/$p" || true
      done
    fi
    ;;
esac
exit 0

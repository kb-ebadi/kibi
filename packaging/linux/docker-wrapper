#!/bin/sh
# Kibi's `docker` (the full kibi package): the bundled docker CLI, talking to
# Kibi's engine unless you chose otherwise. DOCKER_HOST, DOCKER_CONTEXT or a
# `docker context use` of your own always win; Compose and buildx are found in
# /usr/lib/docker/cli-plugins, one of the CLI's standard plugin directories:
# Kibi's (alternatives links to /usr/libexec/kibi/cli-plugins) or, where
# Docker's packages already put theirs there, those.
if [ -z "${DOCKER_HOST:-}" ] && [ -z "${DOCKER_CONTEXT:-}" ]; then
  cfg=${DOCKER_CONFIG:-$HOME/.docker}/config.json
  if [ ! -f "$cfg" ] || ! grep -q '"currentContext"' "$cfg" 2>/dev/null; then
    DOCKER_HOST=unix:///run/kibi/docker.sock
    export DOCKER_HOST
    # With DOCKER_HOST, `docker build` would ask for the "default" context's
    # builder, the engine's own BuildKit, which Kibi doesn't have: Kibi's
    # builder instead, once it is made (crates/kibi/src/buildwith.rs).
    if [ -z "${BUILDX_BUILDER:-}" ] && [ -f "${BUILDX_CONFIG:-${DOCKER_CONFIG:-$HOME/.docker}/buildx}/instances/kibi-build" ]; then
      BUILDX_BUILDER=kibi-build
      export BUILDX_BUILDER
    fi
  fi
fi
exec /usr/libexec/kibi/bin/docker "$@"

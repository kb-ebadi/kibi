# Kibi on a Linux host, as the .deb and .rpm install it: containers on this
# machine's kernel, no VM. Users in the `kibi` group reach the API at
# unix:///run/kibi/docker.sock:
#   docker context create kibi --docker host=unix:///run/kibi/docker.sock
# and, while no Docker engine has it, at /var/run/docker.sock too.
[Unit]
Description=Kibi container engine
Documentation=https://runkibi.kambiz.site
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/kibi daemon
Environment=KIBI_SOCKET=/run/kibi/docker.sock
Environment=KIBI_SOCKET_GROUP=kibi
Environment=HOME=/var/lib/kibi-daemon
# The daemon creates the cgroups its containers run in.
Delegate=yes
KillMode=mixed
Restart=on-failure
# Tools that ignore docker contexts (docker-py, Go's client.FromEnv,
# docker-java, Testcontainers, IDE plugins) look for /var/run/docker.sock
# (/run/docker.sock): when nothing is there, it links to Kibi's socket, whose
# 0660 root:kibi is what counts. Docker's docker.socket or dockerd replaces
# a link when it starts, so Docker keeps the path whenever it runs, and the
# link goes when Kibi stops, if it is still Kibi's.
ExecStartPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" = /run/kibi/docker.sock ] || [ -e /run/docker.sock ] || [ -L /run/docker.sock ] || ln -s /run/kibi/docker.sock /run/docker.sock'
ExecStopPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" != /run/kibi/docker.sock ] || rm -f /run/docker.sock'
RuntimeDirectory=kibi
# 0755: members of kibi reach the socket (itself 0660 root:kibi) through it.
RuntimeDirectoryMode=0755
StateDirectory=kibi-daemon
StateDirectoryMode=0700
# What the daemon writes is for root and the kibi group only (/var/lib/kibi
# itself is 0710: kibi-init sets that, and its own umask, when it starts).
UMask=0027

[Install]
WantedBy=multi-user.target
